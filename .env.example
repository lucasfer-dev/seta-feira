# Sexta owner access (required on a public deployment)
SEXTA_ACCESS_PIN=
SEXTA_SERVER_SECRET=
SEXTA_AGENT_TOKEN=
CRON_SECRET=

# Gemini Developer API - free tier is enough to start
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Supabase - publishable key + chave interna SEXTA; não exponha a chave interna no frontend
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Opcional: se usar um backend separado com secret key, mantenha apenas no servidor
SUPABASE_SECRET_KEY=

# Google Workspace OAuth (crie um OAuth Client tipo Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
SEXTA_TIMEZONE=America/Sao_Paulo

# WhatsApp / Evolution API
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=sexta
EVOLUTION_WEBHOOK_SECRET=
SEXTA_PUBLIC_BASE_URL=http://localhost:3000

# Smart Inbox
SEXTA_MONITOR_ENABLED=true
SEXTA_MONITOR_INTERVAL_SECONDS=60
SEXTA_VIP_CONTACTS=
SEXTA_AUTO_MEMORY_AI=false
SEXTA_SYNC_CACHE_MS=12000

# Android push / Firebase Cloud Messaging (optional until Android wrapper)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

SEXTA_DATA_API_KEY=
