# SEXTA owner access (required on a public deployment)
SEXTA_ACCESS_PIN=
SEXTA_SERVER_SECRET=
SEXTA_AGENT_TOKEN=
CRON_SECRET=

# Gemini Developer API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Vision uses its own failover chain so screen analysis does not hammer one overloaded model.
GEMINI_VISION_MODEL=
GEMINI_VISION_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Local PC capture tuning. Lower values reduce upload/model load while keeping UI legible.
SEXTA_VISION_MAX_WIDTH=1152
SEXTA_VISION_JPEG_QUALITY=60

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Opcional: backend com secret key; mantenha apenas no servidor.
SUPABASE_SECRET_KEY=
SEXTA_DATA_API_KEY=

# Google Workspace OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
SEXTA_TIMEZONE=America/Sao_Paulo

# WhatsApp / Evolution API
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=sexta
EVOLUTION_WEBHOOK_SECRET=
SEXTA_PUBLIC_BASE_URL=http://localhost:3000

# MCP opcional
SEXTA_MCP_SERVERS=
SEXTA_MCP_ALLOW_DESTRUCTIVE=false
HOME_MCP_TOKEN=

# Smart Inbox
SEXTA_MONITOR_ENABLED=true
SEXTA_MONITOR_INTERVAL_SECONDS=60
SEXTA_VIP_CONTACTS=

# Android push / Firebase (opcional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
