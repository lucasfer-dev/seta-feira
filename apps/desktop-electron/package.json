{
  "name": "sexta-desktop",
  "version": "2.4.0",
  "private": true,
  "main": "secure-main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "native:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../native/windows-hands/build.ps1",
    "pack": "npm run native:build && electron-builder --dir",
    "dist": "npm run native:build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "br.com.sexta.desktop",
    "productName": "SEXTA",
    "asar": true,
    "files": [
      "secure-main.cjs",
      "main.cjs",
      "windows-habitat.cjs",
      "preload.cjs",
      "overlay.html",
      "fallback.html"
    ],
    "extraResources": [
      {
        "from": "../../agent",
        "to": "agent",
        "filter": [
          "start-cloud.mjs",
          "agent-v3.mjs",
          "vision-fallback.mjs",
          "runtime-state.mjs",
          "audit.mjs",
          "browser-agent.mjs",
          "windows-hands-native.mjs",
          "windows-ui.mjs",
          "windows-ui-legacy.mjs",
          "windows-hotkey.mjs",
          "windows-type-v2.mjs",
          "windows-ui-actions.mjs",
          "windows-ui-actions-legacy.mjs",
          "windows-control-v2.mjs",
          "windows-control-v2-fallback.mjs",
          "windows-control-v2-legacy.mjs",
          "windows-focus-v2.mjs",
          "hardware.mjs",
          "secure-vault.mjs",
          "wake-word.mjs",
          "app-resolver.mjs"
        ]
      },
      {
        "from": "../../native/windows-hands/bin",
        "to": "agent/native",
        "filter": [
          "SextaHands.exe"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "lucasfer-dev",
        "repo": "seta-feira",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "SEXTA-Setup-${version}-${arch}.${ext}"
  }
}
